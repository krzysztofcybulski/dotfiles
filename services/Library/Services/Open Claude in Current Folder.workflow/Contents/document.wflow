				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
DIR=$(/usr/bin/osascript -e 'tell application "Finder" to POSIX path of (target of front Finder window as alias)' 2&gt;/dev/null)
[ -z "$DIR" ] &amp;&amp; DIR="$HOME"
open -na "Ghostty" --args --working-directory="$DIR" -e /bin/zsh -ic claude</string>
